# ================= إعدادات قاعدة البيانات (PostgreSQL من Neon) =================
DATABASE_URL = os.environ.get("DATABASE_URL")

def get_db():
    conn = psycopg2.connect(DATABASE_URL, cursor_factory=RealDictCursor)
    return conn

def init_db():
    if not DATABASE_URL:
        print("⚠️ تحذير: لم يتم تعيين DATABASE_URL. لن تعمل قاعدة البيانات.")
        return
        
    conn = get_db()
    c = conn.cursor()
    
    # إنشاء الجداول باستخدام SERIAL بدلاً من AUTOINCREMENT
    c.execute('''CREATE TABLE IF NOT EXISTS Centers (
        Center_ID SERIAL PRIMARY KEY, 
        Center_Name TEXT, 
        Capacity_Ratio INTEGER
    )''')
    c.execute('''CREATE TABLE IF NOT EXISTS Specialties (
        Specialty_ID SERIAL PRIMARY KEY, 
        Specialty_Name TEXT
    )''')
    c.execute('''CREATE TABLE IF NOT EXISTS Users (
        User_ID SERIAL PRIMARY KEY, 
        Username TEXT UNIQUE, 
        Full_Name TEXT, 
        Role TEXT, 
        Password TEXT
    )''')
    c.execute('''CREATE TABLE IF NOT EXISTS Patients (
        Patient_ID SERIAL PRIMARY KEY, 
        Full_Name TEXT, 
        Phone_Number TEXT UNIQUE, 
        Address TEXT
    )''')
    c.execute('''CREATE TABLE IF NOT EXISTS Requests (
        Request_ID SERIAL PRIMARY KEY, 
        Patient_ID INTEGER, 
        Request_Type TEXT, 
        Specialty_ID INTEGER, 
        Visit_Reason TEXT, 
        Disease_Type TEXT, 
        Status TEXT, 
        Created_At TIMESTAMP DEFAULT CURRENT_TIMESTAMP
    )''')
    c.execute('''CREATE TABLE IF NOT EXISTS Appointments (
        Appointment_ID SERIAL PRIMARY KEY, 
        Request_ID INTEGER, 
        Patient_ID INTEGER, 
        Appt_Date TEXT, 
        Capacity_Ratio_Applied INTEGER, 
        Patient_Type TEXT,
        SMS_Sent INTEGER DEFAULT 0,
        SMS_Error TEXT
    )''')

    # زراعة البيانات الافتراضية
    c.execute("SELECT COUNT(*) FROM Centers")
    if c.fetchone()['count'] == 0:
        c.execute("INSERT INTO Centers (Center_Name, Capacity_Ratio) VALUES ('عيادة بلسم الطبية', 100)")
        
    c.execute("SELECT COUNT(*) FROM Specialties")
    if c.fetchone()['count'] == 0:
        c.execute("INSERT INTO Specialties (Specialty_Name) VALUES ('الطب العام'), ('الباطنية'), ('الأطفال'), ('القلب والأوعية'), ('العظام')")
        
    c.execute("SELECT COUNT(*) FROM Users WHERE Username = 'admin'")
    if c.fetchone()['count'] == 0:
        c.execute("INSERT INTO Users (Username, Full_Name, Role, Password) VALUES ('admin', 'مدير النظام', 'Admin', 'admin123')")
        
    conn.commit()
    c.close()
    conn.close()

# تهيئة قاعدة البيانات عند بدء التطبيق
with app.app_context():
    init_db()

# ================= بوابة Textbee SMS =================
TEXTBEE_API_KEY = os.environ.get("TEXTBEE_API_KEY")
TEXTBEE_DEVICE_ID = os.environ.get("TEXTBEE_DEVICE_ID")

def send_textbee_sms(phone_number, sms_text):
    url = f"https://api.textbee.dev/api/v1/gateway/devices/{TEXTBEE_DEVICE_ID}/send-sms"
    headers = {"x-api-key": TEXTBEE_API_KEY, "Content-Type": "application/json"}
    
    # تنظيف الرقم والحفاظ على رمز الدولة 967
    clean_phone = str(phone_number).strip().replace(" ", "").replace("-", "")
    if clean_phone.startswith('+'): clean_phone = clean_phone[1:]
    if clean_phone.startswith('00967'): clean_phone = clean_phone[5:]
    if clean_phone.startswith('0'): clean_phone = clean_phone[1:]
    if not clean_phone.startswith('967'): clean_phone = '967' + clean_phone
    
    # ✅ التعديل الصحيح لحقول الإرسال في Textbee
    payload = {"recipients": [clean_phone], "message": sms_text}
    
    try:
        res = requests.post(url, json=payload, headers=headers, timeout=12)
        if res.status_code in [200, 201]:
            return True, f"تم الإرسال بنجاح إلى ({clean_phone})"
        return False, f"فشل مزود الخدمة برمز {res.status_code} - {res.text}"
    except Exception as e:
        return False, f"خطأ اتصال: {str(e)}"

# ================= الصلاحيات وخوارزمية المواعيد =================
def login_required(roles=None):
    def decorator(f):
        @wraps(f)
        def decorated_function(*args, **kwargs):
            if 'user_id' not in session:
                return redirect(url_for('login'))
            if roles and session.get('role') not in roles:
                return render_template_string("<h1 style='text-align:center;margin-top:50px;font-family:sans-serif;'>403 - غير مصرح لك</h1>"), 403
            return f(*args, **kwargs)
        return decorated_function
    return decorator

def calculate_appointment_date(patient_id, request_type, capacity_ratio):
    if request_type == 'Chronic':
        return str(datetime.now().date() + timedelta(days=2)), "Chronic_Priority"

    conn = get_db()
    cursor = conn.cursor()
    cursor.execute("SELECT COUNT(*) FROM Appointments WHERE Patient_ID = %s", (patient_id,))
    past_count = cursor.fetchone()['count']
    conn.close()

    is_new = (past_count == 0)
    patient_status = "New" if is_new else "Returning"
    base_date = datetime.now().date()

    if capacity_ratio == 25: scheduled_date = base_date + timedelta(days=3 if is_new else 90)
    elif capacity_ratio == 50: scheduled_date = base_date + timedelta(days=5 if is_new else 30)
    elif capacity_ratio == 75: scheduled_date = base_date + timedelta(days=4 if is_new else 14)
    else: scheduled_date = base_date + timedelta(days=2 if is_new else 7)

    return str(scheduled_date), patient_status

