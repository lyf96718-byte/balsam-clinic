@app.route('/admin/decision/<int:request_id>/<action>', methods=['POST'])
@login_required(roles=['Admin', 'Staff', 'Doctor'])
def process_decision(request_id, action):
    conn = get_db()
    cursor = conn.cursor()
    
    if action == 'approve':
        cursor.execute("""
            SELECT r.Patient_ID, r.Request_Type, p.Phone_Number, p.Full_Name 
            FROM Requests r JOIN Patients p ON r.Patient_ID = p.Patient_ID 
            WHERE r.Request_ID = %s
        """, (request_id,))
        req = cursor.fetchone()
        
        if req:
            patient_id, req_type, phone, full_name = req['patient_id'], req['request_type'], req['phone_number'], req['full_name']
            
            cursor.execute("SELECT Capacity_Ratio FROM Centers WHERE Center_ID = 1")
            capacity_ratio = cursor.fetchone()['capacity_ratio']

            appt_date, patient_status = calculate_appointment_date(patient_id, req_type, capacity_ratio)

            # إرسال SMS
            sms_body = f"عيادة بلسم: مرحباً {full_name}، تم تأكيد موعدك بتاريخ {appt_date}."
            sms_ok, sms_details = send_textbee_sms(phone, sms_body)

            cursor.execute("""
                INSERT INTO Appointments (Request_ID, Patient_ID, Appt_Date, Capacity_Ratio_Applied, Patient_Type, SMS_Sent, SMS_Error) 
                VALUES (%s, %s, %s, %s, %s, %s, %s)
            """, (request_id, patient_id, appt_date, capacity_ratio, patient_status, 1 if sms_ok else 0, None if sms_ok else sms_details))
            
            cursor.execute("UPDATE Requests SET Status = 'Approved' WHERE Request_ID = %s", (request_id,))
            conn.commit()

            session['alert'] = {
                'icon': 'success' if sms_ok else 'warning',
                'title': 'تم اعتماد الموعد',
                'text': f"تم حجز الموعد بتاريخ {appt_date}. ({sms_details})"
            }

    elif action == 'reject':
        cursor.execute("UPDATE Requests SET Status = 'Rejected' WHERE Request_ID = %s", (request_id,))
        conn.commit()
        session['alert'] = {'icon': 'info', 'title': 'تم الرفض', 'text': 'تم رفض طلب الحجز بنجاح.'}

    conn.close()
    return redirect(url_for('admin_panel'))

@app.route('/submit-request', methods=['POST'])
def submit_request():
    try:
        full_name = request.form.get('full_name', '').strip()
        phone = request.form.get('phone', '').strip()
        address = request.form.get('address', '').strip()
        request_type = request.form.get('request_type', 'Normal')
        specialty_id = request.form.get('specialty_id')
        visit_reason = request.form.get('visit_reason', '').strip()
        disease_type = request.form.get('disease_type', '').strip()

        conn = get_db()
        cursor = conn.cursor()

        cursor.execute("SELECT Patient_ID FROM Patients WHERE Phone_Number = %s", (phone,))
        patient = cursor.fetchone()
        if patient:
            patient_id = patient['patient_id']
            cursor.execute("UPDATE Patients SET Full_Name = %s, Address = %s WHERE Patient_ID = %s", (full_name, address, patient_id))
        else:
            # استخدام RETURNING للحصول على الـ ID الجديد في PostgreSQL
            cursor.execute("INSERT INTO Patients (Full_Name, Phone_Number, Address) VALUES (%s, %s, %s) RETURNING Patient_ID", (full_name, phone, address))
            patient_id = cursor.fetchone()['patient_id']

        cursor.execute("""
            INSERT INTO Requests (Patient_ID, Request_Type, Specialty_ID, Visit_Reason, Disease_Type, Status)
            VALUES (%s, %s, %s, %s, %s, 'Pending')
        """, (patient_id, request_type, specialty_id, visit_reason, disease_type))

        conn.commit()
        conn.close()
        
        flash("تم استلام طلبك بنجاح. ستصلك رسالة SMS فور مراجعته من الإدارة.", "success")
        return redirect(url_for('index'))
    except Exception as e:
        flash(f"حدث خطأ أثناء الحجز: {str(e)}", "error")
        return redirect(url_for('index'))

@app.route('/api/check-status')
def check_status():
    phone = request.args.get('phone', '').strip()
    conn = get_db()
    cursor = conn.cursor()
    cursor.execute("""
        SELECT p.Full_Name, s.Specialty_Name, r.Status, a.Appt_Date 
        FROM Patients p 
        JOIN Requests r ON p.Patient_ID = r.Patient_ID 
        JOIN Specialties s ON r.Specialty_ID = s.Specialty_ID 
        LEFT JOIN Appointments a ON r.Request_ID = a.Request_ID 
        WHERE p.Phone_Number = %s ORDER BY r.Request_ID DESC LIMIT 1
    """, (phone,))
    row = cursor.fetchone()
    conn.close()

    if row:
        status_map = {'Pending': 'قيد المراجعة الطبية', 'Approved': 'معتمد ومجدول', 'Rejected': 'مرفوض'}
        return jsonify({
            'found': True,
            'name': row['full_name'],
            'specialty': row['specialty_name'],
            'status': row['status'],
            'status_arabic': status_map.get(row['status'], row['status']),
            'appt_date': str(row['appt_date']) if row['appt_date'] else None
        })
    return jsonify({'found': False})

